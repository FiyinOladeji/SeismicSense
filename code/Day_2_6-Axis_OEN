// --- Web Server & Captive Portal Handlers ---
void handleRoot() {
  server.send(200, "text/html", EMERGENCY_HTML);
}

void handleStatus() {
  String stateStr = (currentState == STATE_IDLE) ? "IDLE" :
                    (currentState == STATE_VERIFYING) ? "VERIFYING" : "EMERGENCY";

  String json = "{";
  json += "\"state\":\"" + stateStr + "\",";
  json += "\"motion\":" + String(currentAccel, 2) + ",";
  json += "\"peak\":" + String(peakAccel, 2) + ",";
  json += "\"gyro\":" + String(currentGyro, 1) + ",";
  json += "\"gyroConfirmed\":" + String(gyroConfirmed ? "true" : "false") + ",";
  json += "\"sensorOk\":" + String(sensorHealthy ? "true" : "false");
  json += "}";

  server.send(200, "application/json", json);
}

void startEmergencyNetwork() {
  if (emergencyNetworkStarted) return;

  Serial.println("\n[NETWORK] Spinning up offline Emergency SoftAP + Captive Portal...");
  WiFi.mode(WIFI_AP);
  bool success = WiFi.softAP(AP_SSID); // Open network for instant captive portal popup

  if (success) {
    IPAddress apIP = WiFi.softAPIP();
    Serial.println("✅ [NETWORK] Emergency Wi-Fi & Captive Portal ACTIVE!");
    Serial.printf("   SSID: %s (Open Network) | URL: http://%s\n", AP_SSID, apIP.toString().c_str());

    dnsServer.start(DNS_PORT, "*", apIP);

    server.on("/", handleRoot);
    server.on("/status", handleStatus);
    server.on("/generate_204", handleRoot);
    server.on("/gen_204", handleRoot);
    server.on("/hotspot-detect.html", handleRoot);
    server.on("/connecttest.txt", handleRoot);
    server.on("/ncsi.txt", handleRoot);

    server.onNotFound([]() {
      server.sendHeader("Location", "http://192.168.4.1/", true);
      server.send(302, "text/plain", "");
    });

    server.begin();
    emergencyNetworkStarted = true;
  }
}

// --- Step 4: Direct 14-Byte Register Read (Accel + Temp + Gyro) ---
bool writeMPURegister(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return (Wire.endTransmission() == 0);
}

bool readSensor(float &ax, float &ay, float &az, float &gx, float &gy, float &gz) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B); // Start at ACCEL_XOUT_H
  if (Wire.endTransmission(false) != 0) return false;

  // Request all 14 contiguous bytes (6 Accel + 2 Temp + 6 Gyro)
  Wire.requestFrom(MPU_ADDR, (uint8_t)14, (uint8_t)true);
  if (Wire.available() < 14) return false;

  int16_t rawAx = (Wire.read() << 8) | Wire.read();
  int16_t rawAy = (Wire.read() << 8) | Wire.read();
  int16_t rawAz = (Wire.read() << 8) | Wire.read();

  // Discard 2 temperature bytes (0x41 & 0x42)
  Wire.read();
  Wire.read();

  int16_t rawGx = (Wire.read() << 8) | Wire.read();
  int16_t rawGy = (Wire.read() << 8) | Wire.read();
  int16_t rawGz = (Wire.read() << 8) | Wire.read();

  // Convert Accelerometer (+/- 4g -> 8192 LSB/g) to m/s^2
  ax = (rawAx / 8192.0) * 9.80665;
  ay = (rawAy / 8192.0) * 9.80665;
  az = (rawAz / 8192.0) * 9.80665;

  // Convert Gyroscope (+/- 500 deg/s -> 65.5 LSB/deg/s) to deg/s
  gx = rawGx / 65.5;
  gy = rawGy / 65.5;
  gz = rawGz / 65.5;

  return true;
}

// --- Step 9: Calibrate Both Accelerometer and Gyroscope Baselines ---
void calibrateSensor() {
  Serial.println("Calibrating 6-axis baseline... Keep the sensor completely still.");
  const int numSamples = 100;
  float sumAx = 0, sumAy = 0, sumAz = 0;
  float sumGx = 0, sumGy = 0, sumGz = 0;
  int validSamples = 0;

  while (validSamples < numSamples) {
    float ax, ay, az, gx, gy, gz;
    if (readSensor(ax, ay, az, gx, gy, gz)) {
      sumAx += ax; sumAy += ay; sumAz += az;
      sumGx += gx; sumGy += gy; sumGz += gz;
      validSamples++;
    }
    delay(10);
  }

  baseAx = sumAx / numSamples;
  baseAy = sumAy / numSamples;
  baseAz = sumAz / numSamples;

  baseGx = sumGx / numSamples;
  baseGy = sumGy / numSamples;
  baseGz = sumGz / numSamples;

  Serial.printf("Accel Baseline -> X: %.2f, Y: %.2f, Z: %.2f m/s^2\n", baseAx, baseAy, baseAz);
  Serial.printf("Gyro Baseline  -> X: %.2f, Y: %.2f, Z: %.2f deg/s\n", baseGx, baseGy, baseGz);
}

// --- Steps 6, 7 & 9: Compute Filtered Accel & Gyro Magnitudes ---
void updateFilteredTelemetry() {
  float ax, ay, az, gx, gy, gz;
  if (readSensor(ax, ay, az, gx, gy, gz)) {
    sensorHealthy = true;

    // 1. Linear acceleration deviation from gravity baseline
    float dax = ax - baseAx;
    float day = ay - baseAy;
    float daz = az - baseAz;
    float rawAccelMag = sqrt(dax * dax + day * day + daz * daz);

    // 2. Rotational velocity deviation from resting gyro bias
    float dgx = gx - baseGx;
    float dgy = gy - baseGy;
    float dgz = gz - baseGz;
    float rawGyroMag = sqrt(dgx * dgx + dgy * dgy + dgz * dgz);

    accelBuffer[bufferIndex] = rawAccelMag;
    gyroBuffer[bufferIndex]  = rawGyroMag;
    bufferIndex = (bufferIndex + 1) % FILTER_SIZE;
  } else {
    sensorHealthy = false;
    Serial.println("[WARNING] I2C Read Missed - Check loose SDA/SCL pins!");
  }

  float sumA = 0.0, sumG = 0.0;
  for (int i = 0; i < FILTER_SIZE; i++) {
    sumA += accelBuffer[i];
    sumG += gyroBuffer[i];
  }
  currentAccel = sumA / FILTER_SIZE;
  currentGyro  = sumG / FILTER_SIZE;

  if (currentAccel > peakAccel) peakAccel = currentAccel;
  if (currentGyro > peakGyro)   peakGyro  = currentGyro;
}

// --- Steps 11 & 12: State Machine with Gyro Confidence Confirmation ---
void updateStateMachine(float accelMotion, float gyroMotion) {
  unsigned long now = millis();

  bool accelTriggered = (accelMotion >= MOTION_THRESHOLD);
  bool gyroTriggered  = (gyroMotion >= GYRO_THRESHOLD);

  switch (currentState) {
    case STATE_IDLE:
      digitalWrite(LED_PIN, LOW);
      noTone(BUZZER_PIN);
      digitalWrite(BUZZER_PIN, LOW);

      if (accelTriggered) {
        currentState = STATE_VERIFYING;
        verifyStartTime = now;
        gyroConfirmed = gyroTriggered;
        Serial.println("[STATE] IDLE -> VERIFYING (Abnormal motion detected...)");
      }
      break;

    case STATE_VERIFYING:
      digitalWrite(LED_PIN, (now / 100) % 2);
      if (gyroTriggered) gyroConfirmed = true; // Latch if gyro agrees during verification

      // If both Accel + Gyro agree, confirm faster (700ms); otherwise require full 1000ms
      unsigned long requiredDuration = gyroConfirmed ? 700 : VERIFY_DURATION;

      if (!accelTriggered) {
        currentState = STATE_IDLE;
        Serial.println("[STATE] VERIFYING -> IDLE (Transient spike ignored)");
      } 
      else if (now - verifyStartTime >= requiredDuration) {
        currentState = STATE_EMERGENCY;
        emergencyStartTime = now;
        Serial.println("==========================================");
        Serial.printf("🚨 [STATE] EARTHQUAKE DETECTED! (6-Axis Gyro Confirmed: %s)\n", 
                      gyroConfirmed ? "YES" : "LINEAR ONLY");
        Serial.println("==========================================");
        
        startEmergencyNetwork();
      }
      break;

    case STATE_EMERGENCY:
      digitalWrite(LED_PIN, HIGH);
      if (gyroTriggered) gyroConfirmed = true;

      if ((now / 250) % 2 == 0) {
        tone(BUZZER_PIN, 2500);
      } else {
        tone(BUZZER_PIN, 1800);
      }

      if (now - emergencyStartTime >= EMERGENCY_COOLDOWN && !accelTriggered) {
        currentState = STATE_IDLE;
        noTone(BUZZER_PIN);
        digitalWrite(BUZZER_PIN, LOW);
        Serial.println("[STATE] EMERGENCY -> IDLE (Alarm silenced, Captive Portal remains active)");
      }
      break;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  WiFi.mode(WIFI_OFF);

  Serial.println("\n=== SEISMICSENSE: 6-AXIS SENSOR FUSION + PORTAL ===");
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setTimeOut(100);

  if (!writeMPURegister(0x6B, 0x00)) {
    Serial.println("ERROR: MPU chip not responding at 0x68! Waiting for connection...");
    while (!writeMPURegister(0x6B, 0x00)) {
      digitalWrite(LED_PIN, !digitalRead(LED_PIN));
      delay(500);
    }
  }
