void handleRoot() {
  server.send(200, "text/html", EMERGENCY_HTML);
}

String nodeToJson(int id) {
  bool isOnline = (id == 1) || (nodes[id].online && (millis() - nodes[id].lastSeen < 3000));
  String s = "{";
  s += "\"online\":" + String(isOnline ? "true" : "false") + ",";
  s += "\"state\":" + String(nodes[id].state) + ",";
  s += "\"accel\":" + String(nodes[id].accel, 2) + ",";
  s += "\"gyro\":" + String(nodes[id].gyro, 1);
  s += "}";
  return s;
}

void handleStatus() {
  int onlineCount = 1;
  if (nodes[2].online && (millis() - nodes[2].lastSeen < 3000)) onlineCount++;
  if (nodes[3].online && (millis() - nodes[3].lastSeen < 3000)) onlineCount++;

  String json = "{";
  json += "\"peak\":" + String(peakAccel, 2) + ",";
  json += "\"alertNodes\":" + String(activeAlertNodes) + ",";
  json += "\"onlineNodes\":" + String(onlineCount) + ",";
  json += "\"n1\":" + nodeToJson(1) + ",";
  json += "\"n2\":" + nodeToJson(2) + ",";
  json += "\"n3\":" + nodeToJson(3);
  json += "}";

  server.send(200, "application/json", json);
}

void startEmergencyNetwork() {
  if (emergencyNetworkStarted) return;

  Serial.println("\n[GATEWAY] Launching SoftAP on Channel 1 (Keeping ESP-NOW Alive)...");
  WiFi.mode(WIFI_AP_STA);
  bool success = WiFi.softAP(AP_SSID, NULL, WIFI_CHANNEL);

  if (success) {
    IPAddress apIP = WiFi.softAPIP();
    Serial.printf("✅ [GATEWAY] Captive Portal LIVE at http://%s (Channel %d)\n", apIP.toString().c_str(), WIFI_CHANNEL);

    dnsServer.start(DNS_PORT, "*", apIP);
    server.on("/", handleRoot);
    server.on("/status", handleStatus);
    server.on("/generate_204", handleRoot);
    server.on("/gen_204", handleRoot);
    server.on("/hotspot-detect.html", handleRoot);
    server.on("/connecttest.txt", handleRoot);
    server.on("/ncsi.txt", handleRoot);

    server.onNotFound([]() {
      server.sendHeader("Location", "http://192.168.4.1/", true);
      server.send(302, "text/plain", "");
    });

    server.begin();
    emergencyNetworkStarted = true;
  }
}

bool writeMPURegister(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return (Wire.endTransmission() == 0);
}

bool readSensor(float &ax, float &ay, float &az, float &gx, float &gy, float &gz) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;

  Wire.requestFrom(MPU_ADDR, (uint8_t)14, (uint8_t)true);
  if (Wire.available() < 14) return false;

  int16_t rawAx = (Wire.read() << 8) | Wire.read();
  int16_t rawAy = (Wire.read() << 8) | Wire.read();
  int16_t rawAz = (Wire.read() << 8) | Wire.read();
  Wire.read(); Wire.read();
  int16_t rawGx = (Wire.read() << 8) | Wire.read();
  int16_t rawGy = (Wire.read() << 8) | Wire.read();
  int16_t rawGz = (Wire.read() << 8) | Wire.read();

  ax = (rawAx / 8192.0) * 9.80665;
  ay = (rawAy / 8192.0) * 9.80665;
  az = (rawAz / 8192.0) * 9.80665;
  gx = rawGx / 65.5;
  gy = rawGy / 65.5;
  gz = rawGz / 65.5;
  return true;
}

void calibrateSensor() {
  Serial.println("[GATEWAY NODE 1] Calibrating 6-axis baseline...");
  float sumAx = 0, sumAy = 0, sumAz = 0, sumGx = 0, sumGy = 0, sumGz = 0;
  int valid = 0;
  while (valid < 100) {
    float ax, ay, az, gx, gy, gz;
    if (readSensor(ax, ay, az, gx, gy, gz)) {
      sumAx += ax; sumAy += ay; sumAz += az;
      sumGx += gx; sumGy += gy; sumGz += gz;
      valid++;
    }
    delay(10);
  }
  baseAx = sumAx / 100.0; baseAy = sumAy / 100.0; baseAz = sumAz / 100.0;
  baseGx = sumGx / 100.0; baseGy = sumGy / 100.0; baseGz = sumGz / 100.0;
  Serial.println("[GATEWAY NODE 1] Baseline Locked!");
}

void updateLocalNode1() {
  unsigned long now = millis();
  float ax, ay, az, gx, gy, gz;
  if (readSensor(ax, ay, az, gx, gy, gz)) {
    nodes[1].sensorOk = true;
    float dax = ax - baseAx, day = ay - baseAy, daz = az - baseAz;
    float dgx = gx - baseGx, dgy = gy - baseGy, dgz = gz - baseGz;
    accelBuffer[bufferIndex] = sqrt(dax*dax + day*day + daz*daz);
    gyroBuffer[bufferIndex]  = sqrt(dgx*dgx + dgy*dgy + dgz*dgz);
    bufferIndex = (bufferIndex + 1) % FILTER_SIZE;
  } else {
    nodes[1].sensorOk = false;
  }

  float sumA = 0, sumG = 0;
  for (int i = 0; i < FILTER_SIZE; i++) {
    sumA += accelBuffer[i];
    sumG += gyroBuffer[i];
  }
  nodes[1].online = true;
  nodes[1].accel = sumA / FILTER_SIZE;
  nodes[1].gyro  = sumG / FILTER_SIZE;
  nodes[1].lastSeen = now;
  if (nodes[1].accel > peakAccel) peakAccel = nodes[1].accel;

  bool triggered = (nodes[1].accel >= MOTION_THRESHOLD);
  if (localNodeState == STATE_IDLE && triggered) {
    localNodeState = STATE_VERIFYING;
    localVerifyStart = now;
  } else if (localNodeState == STATE_VERIFYING) {
    if (!triggered) localNodeState = STATE_IDLE;
    else if (now - localVerifyStart >= VERIFY_DURATION) localNodeState = STATE_EMERGENCY;
  } else if (localNodeState == STATE_EMERGENCY && !triggered) {
    if (now - localVerifyStart >= 5000) localNodeState = STATE_IDLE;
  }
  nodes[1].state = (uint8_t)localNodeState;
}

void broadcastGlobalEmergencySync() {
  SensorMessage syncMsg;
  syncMsg.nodeID = 1;
  syncMsg.state = STATE_EMERGENCY;
  syncMsg.acceleration = nodes[1].accel;
  syncMsg.gyro = nodes[1].gyro;
  syncMsg.sensorHealthy = nodes[1].sensorOk;
  syncMsg.globalEmergency = true;
  esp_now_send(broadcastAddress, (uint8_t *)&syncMsg, sizeof(syncMsg));
}

void evaluateMultiNodeConsensus() {
  unsigned long now = millis();
  int verifyingOrEmergencyCount = 0;
  int confirmedEmergencyCount = 0;

  for (int i = 1; i <= 3; i++) {
    bool fresh = (i == 1) || (nodes[i].online && (now - nodes[i].lastSeen < 2500));
    if (fresh) {
      if (nodes[i].state >= STATE_VERIFYING) verifyingOrEmergencyCount++;
      if (nodes[i].state == STATE_EMERGENCY) confirmedEmergencyCount++;
    }
  }
  activeAlertNodes = verifyingOrEmergencyCount;

  bool consensusEmergency = (verifyingOrEmergencyCount >= 2 && confirmedEmergencyCount >= 1) ||
                            (confirmedEmergencyCount >= 1 && (now - localVerifyStart >= SINGLE_NODE_FALLBACK));

  switch (gatewayState) {
    case STATE_IDLE:
      digitalWrite(LED_PIN, LOW);
      noTone(BUZZER_PIN);
      digitalWrite(BUZZER_PIN, LOW);
      if (consensusEmergency) {
        gatewayState = STATE_EMERGENCY;
        emergencyStartTime = now;
        Serial.println("=====================================================");
        Serial.printf("🚨 [GATEWAY CONSENSUS] EARTHQUAKE CONFIRMED (%d NODES)!\n", activeAlertNodes);
        Serial.println("=====================================================");
        startEmergencyNetwork();
      } else if (verifyingOrEmergencyCount == 1) {
        gatewayState = STATE_VERIFYING;
      }
      break;

    case STATE_VERIFYING:
      digitalWrite(LED_PIN, (now / 100) % 2);
      if (consensusEmergency) {
        gatewayState = STATE_EMERGENCY;
        emergencyStartTime = now;
        Serial.println("=====================================================");
        Serial.printf("🚨 [GATEWAY CONSENSUS] EARTHQUAKE CONFIRMED (%d NODES)!\n", activeAlertNodes);
        Serial.println("=====================================================");
        startEmergencyNetwork();
      } else if (verifyingOrEmergencyCount == 0) {
        gatewayState = STATE_IDLE;
      }
      break;

    case STATE_EMERGENCY:
      digitalWrite(LED_PIN, HIGH);
      if ((now / 250) % 2 == 0) tone(BUZZER_PIN, 2500);
      else tone(BUZZER_PIN, 1800);

      if (now - emergencyStartTime >= EMERGENCY_COOLDOWN && verifyingOrEmergencyCount == 0) {
        gatewayState = STATE_IDLE;
        noTone(BUZZER_PIN);
        digitalWrite(BUZZER_PIN, LOW);
      }
      break;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  Serial.println("\n=== SEISMICSENSE: GATEWAY (NODE 1) + ESP-NOW MESH ===");
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setTimeOut(100);

  while (!writeMPURegister(0x6B, 0x00)) {
    Serial.println("Waiting for Gateway MPU6050...");
    digitalWrite(LED_PIN, !digitalRead(LED_PIN));
    delay(500);
  }
  writeMPURegister(0x1C, 0x08);
  writeMPURegister(0x1B, 0x08);
  writeMPURegister(0x1A, 0x04);
  calibrateSensor();

  WiFi.mode(WIFI_STA);
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);

  if (esp_now_init() == ESP_OK) {
    esp_now_register_recv_cb(OnDataRecv);
    memcpy(peerInfo.peer_addr, broadcastAddress, 6);
    peerInfo.channel = WIFI_CHANNEL;
    peerInfo.encrypt = false;
    esp_now_add_peer(&peerInfo);
    Serial.println("✅ [ESP-NOW] Gateway bidirectional mesh active on Channel 1!");
  }
}

void loop() {
  unsigned long now = millis();

  if (now - lastSampleTime >= 20) {
    lastSampleTime = now;
    updateLocalNode1();
    evaluateMultiNodeConsensus();

    if (now - lastPrintTime >= 250) {
      lastPrintTime = now;
      if (gatewayState == STATE_EMERGENCY) {
        broadcastGlobalEmergencySync(); // Tell Nodes 2 & 3 to sound their alarms too!
      }
      Serial.printf("GW State: %d | N1: %.2f(S:%d) | N2: %.2f(S:%d) | N3: %.2f(S:%d)\n",
                    gatewayState,
                    nodes[1].accel, nodes[1].state,
                    nodes[2].online ? nodes[2].accel : 0.0, nodes[2].state,
                    nodes[3].online ? nodes[3].accel : 0.0, nodes[3].state);
    }
  }

  if (emergencyNetworkStarted) {
    dnsServer.processNextRequest();
    server.handleClient();
  }
}
