// --- ESP-NOW Packet Structure (Matches Remote Nodes) ---
typedef struct SensorMessage {
  uint8_t nodeID;
  uint8_t state;
  float acceleration;
  float gyro;
  bool sensorHealthy;
  bool globalEmergency;
} SensorMessage;

struct NodeStatus {
  bool online;
  uint8_t state;
  float accel;
  float gyro;
  bool sensorOk;
  unsigned long lastSeen;
};

NodeStatus nodes[4]; // Index 1 = Node 1 (GW), 2 = Node 2, 3 = Node 3
int activeAlertNodes = 0;

float baseAx = 0, baseAy = 0, baseAz = 0;
float baseGx = 0, baseGy = 0, baseGz = 0;
float peakAccel = 0;

const int FILTER_SIZE = 5;
float accelBuffer[FILTER_SIZE] = {0.0};
float gyroBuffer[FILTER_SIZE] = {0.0};
int bufferIndex = 0;

unsigned long localVerifyStart = 0;
unsigned long emergencyStartTime = 0;
unsigned long lastSampleTime = 0;
unsigned long lastPrintTime = 0;

#if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len) {
#else
void OnDataRecv(const uint8_t *mac, const uint8_t *incomingData, int len) {
#endif
  if (len == sizeof(SensorMessage)) {
    SensorMessage msg;
    memcpy(&msg, incomingData, sizeof(msg));

    if (msg.nodeID >= 2 && msg.nodeID <= 3) {
      nodes[msg.nodeID].online = true;
      nodes[msg.nodeID].state = msg.state;
      nodes[msg.nodeID].accel = msg.acceleration;
      nodes[msg.nodeID].gyro = msg.gyro;
      nodes[msg.nodeID].sensorOk = msg.sensorHealthy;
      nodes[msg.nodeID].lastSeen = millis();

      if (msg.acceleration > peakAccel) {
        peakAccel = msg.acceleration;
      }
    }
  }
}

