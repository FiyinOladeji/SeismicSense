#include <Wire.h>
#include <math.h>

// --- I2C Address & Hardware Pins ---
const uint8_t MPU_ADDR = 0x68; // Use 0x69 if AD0 pin is pulled HIGH
const int I2C_SDA = 21;
const int I2C_SCL = 22;
const int LED_PIN = 2;      
const int BUZZER_PIN = 4;  

// --- Tunable Detection Parameters ---
const float MOTION_THRESHOLD = 1.5;             // m/s^2 deviation above baseline
const unsigned long VERIFY_DURATION = 1000;     // 1000ms sustained shaking required
const unsigned long EMERGENCY_COOLDOWN = 10000; // 10s latch in emergency mode
const unsigned long SAMPLE_INTERVAL = 20;       // 50Hz loop rate (20ms)
const unsigned long PRINT_INTERVAL = 200;       // Serial status print rate (200ms)

// --- State & Baseline Globals ---
enum SystemState { STATE_IDLE, STATE_VERIFYING, STATE_EMERGENCY };
SystemState currentState = STATE_IDLE;

float baseX = 0.0, baseY = 0.0, baseZ = 0.0;
const int FILTER_SIZE = 5;
float motionBuffer[FILTER_SIZE] = {0.0};
int bufferIndex = 0;

unsigned long verifyStartTime = 0;
unsigned long emergencyStartTime = 0;
unsigned long lastSampleTime = 0;
unsigned long lastPrintTime = 0;

// --- Helper: Write a single byte to an MPU register ---
bool writeMPURegister(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return (Wire.endTransmission() == 0);
}

// --- Helper: Read X, Y, Z acceleration in m/s^2 directly from 0x3B ---
bool readAccel(float &ax, float &ay, float &az) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;

  Wire.requestFrom(MPU_ADDR, (uint8_t)6, (uint8_t)true);
  if (Wire.available() < 6) return false;

  int16_t rawX = (Wire.read() << 8) | Wire.read();
  int16_t rawY = (Wire.read() << 8) | Wire.read();
  int16_t rawZ = (Wire.read() << 8) | Wire.read();

  ax = (rawX / 8192.0) * 9.80665;
  ay = (rawY / 8192.0) * 9.80665;
  az = (rawZ / 8192.0) * 9.80665;
  return true;
}

void calibrateSensor() {
  Serial.println("Calibrating baseline... Keep the sensor completely still.");
  const int numSamples = 100;
  float sumX = 0.0, sumY = 0.0, sumZ = 0.0;
  int validSamples = 0;

  while (validSamples < numSamples) {
    float ax, ay, az;
    if (readAccel(ax, ay, az)) {
      sumX += ax;
      sumY += ay;
      sumZ += az;
      validSamples++;
    }
    delay(10);
  }

  baseX = sumX / numSamples;
  baseY = sumY / numSamples;
  baseZ = sumZ / numSamples;

  Serial.printf("Baseline Locked -> X: %.2f, Y: %.2f, Z: %.2f m/s^2\n", baseX, baseY, baseZ);
}

float getFilteredMotion() {
  float ax, ay, az;
  if (readAccel(ax, ay, az)) {
    float dx = ax - baseX;
    float dy = ay - baseY;
    float dz = az - baseZ;

    float rawMagnitude = sqrt((dx * dx) + (dy * dy) + (dz * dz));

    motionBuffer[bufferIndex] = rawMagnitude;
    bufferIndex = (bufferIndex + 1) % FILTER_SIZE;
  } else {
    Serial.println("[WARNING] I2C Read Missed - Check loose SDA/SCL pins!");
  }

  float sum = 0.0;
  for (int i = 0; i < FILTER_SIZE; i++) {
    sum += motionBuffer[i];
  }
  return sum / FILTER_SIZE;
}

void updateStateMachine(float motion) {
  unsigned long now = millis();

  switch (currentState) {
    case STATE_IDLE:
      digitalWrite(LED_PIN, LOW);
      digitalWrite(BUZZER_PIN, LOW);

      if (motion >= MOTION_THRESHOLD) {
        currentState = STATE_VERIFYING;
        verifyStartTime = now;
        Serial.println("[STATE] IDLE -> VERIFYING (Abnormal motion detected...)");
      }
      break;

    case STATE_VERIFYING:
      digitalWrite(LED_PIN, (now / 100) % 2);

      if (motion < MOTION_THRESHOLD) {
        currentState = STATE_IDLE;
        Serial.println("[STATE] VERIFYING -> IDLE (Transient spike ignored)");
      }
      else if (now - verifyStartTime >= VERIFY_DURATION) {
        currentState = STATE_EMERGENCY;
        emergencyStartTime = now;
        Serial.println("==========================================");
        Serial.println("🚨 [STATE] EARTHQUAKE DETECTED! EMERGENCY!");
        Serial.println("==========================================");
      }
      break;

    case STATE_EMERGENCY:
      digitalWrite(LED_PIN, HIGH);
      digitalWrite(BUZZER_PIN, HIGH);

      if (now - emergencyStartTime >= EMERGENCY_COOLDOWN && motion < MOTION_THRESHOLD) {
        currentState = STATE_IDLE;
        Serial.println("[STATE] EMERGENCY -> IDLE (Cooldown complete, system reset)");
      }
      break;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  Serial.println("\n=== SEISMIC GUARDIAN: DAY 1 CORE (CLONE-SAFE I2C) ===");
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setTimeOut(100); // Prevents loose wires from hanging the ESP32

  // 1. Wake up MPU chip (Register 0x6B -> 0x00)
  if (!writeMPURegister(0x6B, 0x00)) {
    Serial.println("ERROR: MPU chip not responding at 0x68! Waiting for connection...");
    while (!writeMPURegister(0x6B, 0x00)) {
      Serial.println("[RETRY] Still cannot reach 0x68 on SDA(21)/SCL(22)...");
      digitalWrite(LED_PIN, !digitalRead(LED_PIN));
      delay(500);
    }
  }
  Serial.println("SUCCESS: MPU Chip Awake!");

  // 2. Set Accelerometer Range to +/- 4g (Register 0x1C -> 0x08)
  writeMPURegister(0x1C, 0x08);

  // 3. Enable 21Hz Hardware Digital Low-Pass Filter (Register 0x1A -> 0x04)
  writeMPURegister(0x1A, 0x04);

  calibrateSensor();
  Serial.println("System READY. Monitoring structural motion...\n");
}

void loop() {
  unsigned long now = millis();

  // Sample sensor & update state machine at 50Hz (every 20ms)
  if (now - lastSampleTime >= SAMPLE_INTERVAL) {
    lastSampleTime = now;
    float filteredMotion = getFilteredMotion();
    updateStateMachine(filteredMotion);

    // Print diagnostics every 200ms
    if (now - lastPrintTime >= PRINT_INTERVAL) {
      lastPrintTime = now;
      const char* stateStr = (currentState == STATE_IDLE) ? "IDLE" :
                             (currentState == STATE_VERIFYING) ? "VERIFYING" : "EMERGENCY";
      Serial.printf("State: %-10s | Motion: %.2f m/s^2 | Threshold: %.2f\n",
                    stateStr, filteredMotion, MOTION_THRESHOLD);
    }
  }
}
