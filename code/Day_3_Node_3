#include <Wire.h>
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <math.h>

// =========================================================
// CHANGE THIS ID FOR EACH REMOTE BOARD (2 for Node 2, 3 for Node 3)
// =========================================================
#define NODE_ID 3

const uint8_t WIFI_CHANNEL = 1;
uint8_t broadcastAddress[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

// --- Identical Hardware Pins Across All Nodes ---
const uint8_t MPU_ADDR = 0x68;
const int I2C_SDA = 21;
const int I2C_SCL = 22;
const int LED_PIN = 2;      // External LED (+ onboard LED)
const int BUZZER_PIN = 4;   // Transistor-driven buzzer

// --- Tunable Thresholds ---
const float MOTION_THRESHOLD = 1.5;         // m/s^2
const float GYRO_THRESHOLD = 15.0;          // deg/s
const unsigned long VERIFY_DURATION = 800;  // ms sustained motion to confirm local emergency
const unsigned long SAMPLE_INTERVAL = 20;   // 50Hz sampling
const unsigned long TX_INTERVAL = 200;      // Send heartbeat packet every 200ms

enum SystemState { STATE_IDLE = 0, STATE_VERIFYING = 1, STATE_EMERGENCY = 2 };
SystemState currentState = STATE_IDLE;
bool gatewayOrderedEmergency = false;
unsigned long lastGatewayAlertTime = 0;

typedef struct SensorMessage {
  uint8_t nodeID;
  uint8_t state;
  float acceleration;
  float gyro;
  bool sensorHealthy;
  bool globalEmergency; // True when Gateway triggers building-wide alarm
} SensorMessage;

SensorMessage outgoingMsg;
esp_now_peer_info_t peerInfo;

float baseAx = 0, baseAy = 0, baseAz = 0;
float baseGx = 0, baseGy = 0, baseGz = 0;
float currentAccel = 0, currentGyro = 0;
bool sensorHealthy = true;

const int FILTER_SIZE = 5;
float accelBuffer[FILTER_SIZE] = {0.0};
float gyroBuffer[FILTER_SIZE] = {0.0};
int bufferIndex = 0;

unsigned long verifyStartTime = 0;
unsigned long emergencyStartTime = 0;
unsigned long lastSampleTime = 0;
unsigned long lastTxTime = 0;

// Listen for Gateway's building-wide alarm broadcast so all buzzers sync up!
#if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len) {
#else
void OnDataRecv(const uint8_t *mac, const uint8_t *incomingData, int len) {
#endif
  if (len == sizeof(SensorMessage)) {
    SensorMessage msg;
    memcpy(&msg, incomingData, sizeof(msg));
    if (msg.nodeID == 1 && msg.globalEmergency) {
      gatewayOrderedEmergency = true;
      lastGatewayAlertTime = millis();
    }
  }
}

bool writeMPURegister(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return (Wire.endTransmission() == 0);
}

bool readSensor(float &ax, float &ay, float &az, float &gx, float &gy, float &gz) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;

  Wire.requestFrom(MPU_ADDR, (uint8_t)14, (uint8_t)true);
  if (Wire.available() < 14) return false;

  int16_t rawAx = (Wire.read() << 8) | Wire.read();
  int16_t rawAy = (Wire.read() << 8) | Wire.read();
  int16_t rawAz = (Wire.read() << 8) | Wire.read();
  Wire.read(); Wire.read(); // Skip temp
  int16_t rawGx = (Wire.read() << 8) | Wire.read();
  int16_t rawGy = (Wire.read() << 8) | Wire.read();
  int16_t rawGz = (Wire.read() << 8) | Wire.read();

  ax = (rawAx / 8192.0) * 9.80665;
  ay = (rawAy / 8192.0) * 9.80665;
  az = (rawAz / 8192.0) * 9.80665;
  gx = rawGx / 65.5;
  gy = rawGy / 65.5;
  gz = rawGz / 65.5;
  return true;
}

void calibrateSensor() {
  Serial.printf("[NODE %d] Calibrating 6-axis baseline...\n", NODE_ID);
  float sumAx = 0, sumAy = 0, sumAz = 0, sumGx = 0, sumGy = 0, sumGz = 0;
  int valid = 0;
  while (valid < 100) {
    float ax, ay, az, gx, gy, gz;
    if (readSensor(ax, ay, az, gx, gy, gz)) {
      sumAx += ax; sumAy += ay; sumAz += az;
      sumGx += gx; sumGy += gy; sumGz += gz;
      valid++;
    }
    delay(10);
  }
  baseAx = sumAx / 100.0; baseAy = sumAy / 100.0; baseAz = sumAz / 100.0;
  baseGx = sumGx / 100.0; baseGy = sumGy / 100.0; baseGz = sumGz / 100.0;
  Serial.printf("[NODE %d] Baseline Locked!\n", NODE_ID);
}

void updateTelemetry() {
  float ax, ay, az, gx, gy, gz;
  if (readSensor(ax, ay, az, gx, gy, gz)) {
    sensorHealthy = true;
    float dax = ax - baseAx, day = ay - baseAy, daz = az - baseAz;
    float dgx = gx - baseGx, dgy = gy - baseGy, dgz = gz - baseGz;
    accelBuffer[bufferIndex] = sqrt(dax*dax + day*day + daz*daz);
    gyroBuffer[bufferIndex]  = sqrt(dgx*dgx + dgy*dgy + dgz*dgz);
    bufferIndex = (bufferIndex + 1) % FILTER_SIZE;
  } else {
    sensorHealthy = false;
  }

  float sumA = 0, sumG = 0;
  for (int i = 0; i < FILTER_SIZE; i++) {
    sumA += accelBuffer[i];
    sumG += gyroBuffer[i];
  }
  currentAccel = sumA / FILTER_SIZE;
  currentGyro  = sumG / FILTER_SIZE;
}

void broadcastPacket() {
  outgoingMsg.nodeID = NODE_ID;
  outgoingMsg.state = (uint8_t)currentState;
  outgoingMsg.acceleration = currentAccel;
  outgoingMsg.gyro = currentGyro;
  outgoingMsg.sensorHealthy = sensorHealthy;
  outgoingMsg.globalEmergency = false;

  esp_now_send(broadcastAddress, (uint8_t *)&outgoingMsg, sizeof(outgoingMsg));
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  Serial.printf("\n=== SEISMICSENSE: REMOTE SENSOR NODE #%d ===\n", NODE_ID);
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setTimeOut(100);

  while (!writeMPURegister(0x6B, 0x00)) {
    Serial.println("Waiting for MPU6050 on SDA(21)/SCL(22)...");
    digitalWrite(LED_PIN, !digitalRead(LED_PIN));
    delay(500);
  }
  writeMPURegister(0x1C, 0x08); // +/- 4g
  writeMPURegister(0x1B, 0x08); // +/- 500 deg/s
  writeMPURegister(0x1A, 0x04); // 21Hz DLPF
  calibrateSensor();

  WiFi.mode(WIFI_STA);
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ERROR: ESP-NOW Init Failed!");
    return;
  }

  esp_now_register_recv_cb(OnDataRecv);

  memcpy(peerInfo.peer_addr, broadcastAddress, 6);
  peerInfo.channel = WIFI_CHANNEL;
  peerInfo.encrypt = false;
  esp_now_add_peer(&peerInfo);

  Serial.printf("[NODE %d] ESP-NOW Ready on Channel %d!\n", NODE_ID, WIFI_CHANNEL);
}

void loop() {
  unsigned long now = millis();

  // Clear Gateway alarm override if Gateway stopped broadcasting it
  if (gatewayOrderedEmergency && (now - lastGatewayAlertTime > 1500)) {
    gatewayOrderedEmergency = false;
  }

  if (now - lastSampleTime >= SAMPLE_INTERVAL) {
    lastSampleTime = now;
    updateTelemetry();

    bool triggered = (currentAccel >= MOTION_THRESHOLD);
    SystemState prevState = currentState;

    switch (currentState) {
      case STATE_IDLE:
        if (gatewayOrderedEmergency) {
          // If Gateway declared building-wide emergency, sound this node's alarm too!
          digitalWrite(LED_PIN, HIGH);
          if ((now / 250) % 2 == 0) tone(BUZZER_PIN, 2500);
          else tone(BUZZER_PIN, 1800);
        } else {
          digitalWrite(LED_PIN, LOW);
          noTone(BUZZER_PIN);
          digitalWrite(BUZZER_PIN, LOW);
        }

        if (triggered) {
          currentState = STATE_VERIFYING;
          verifyStartTime = now;
        }
        break;

      case STATE_VERIFYING:
        digitalWrite(LED_PIN, (now / 100) % 2);
        if (!triggered) {
          currentState = STATE_IDLE;
        } else if (now - verifyStartTime >= VERIFY_DURATION) {
          currentState = STATE_EMERGENCY;
          emergencyStartTime = now;
        }
        break;

      case STATE_EMERGENCY:
        digitalWrite(LED_PIN, HIGH);
        // Dual-tone siren on remote node
        if ((now / 250) % 2 == 0) {
          tone(BUZZER_PIN, 2500);
        } else {
          tone(BUZZER_PIN, 1800);
        }

        if (now - emergencyStartTime >= 10000 && !triggered) {
          currentState = STATE_IDLE;
          noTone(BUZZER_PIN);
          digitalWrite(BUZZER_PIN, LOW);
        }
        break;
    }

    if (currentState != prevState) {
      broadcastPacket();
    }
  }

  if (now - lastTxTime >= TX_INTERVAL) {
    lastTxTime = now;
    broadcastPacket();
    Serial.printf("[NODE %d TX] State: %d | ACC: %.2f m/s^2 | GYRO: %.1f deg/s\n",
                  NODE_ID, currentState, currentAccel, currentGyro);
  }
}
