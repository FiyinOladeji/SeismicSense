#include <Wire.h>

const uint8_t MPU_ADDR = 0x68; // Default I2C address (0x69 if AD0 is HIGH)
const int I2C_SDA = 21;
const int I2C_SCL = 22;

bool writeMPURegister(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return (Wire.endTransmission() == 0);
}

bool readAccel(float &ax, float &ay, float &az) {
  // 1. Point to register 0x3B (ACCEL_XOUT_H)
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  // 2. Request 6 contiguous bytes (X_H, X_L, Y_H, Y_L, Z_H, Z_L)
  Wire.requestFrom(MPU_ADDR, (uint8_t)6, (uint8_t)true);
  if (Wire.available() < 6) {
    return false;
  }

  // 3. Combine high and low bytes into signed 16-bit integers
  int16_t rawX = (Wire.read() << 8) | Wire.read();
  int16_t rawY = (Wire.read() << 8) | Wire.read();
  int16_t rawZ = (Wire.read() << 8) | Wire.read();

  // 4. Convert to m/s^2 (+/- 4g scale = 8192 LSB/g; 1g = 9.80665 m/s^2)
  ax = (rawX / 8192.0) * 9.80665;
  ay = (rawY / 8192.0) * 9.80665;
  az = (rawZ / 8192.0) * 9.80665;
  return true;
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n=== DAY 1: MPU6050 ACCELEROMETER HARDWARE TEST ===");
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setTimeOut(100);

  // 1. Wake up MPU6050 (Write 0x00 to Power Management Register 0x6B)
  if (!writeMPURegister(0x6B, 0x00)) {
    Serial.println("❌ ERROR: MPU6050 not detected at 0x68! Check VCC, GND, SDA(21), SCL(22).");
    while (1) {
      delay(500);
    }
  }

  // 2. Set Accelerometer Range to +/- 4g (Register 0x1C -> 0x08)
  writeMPURegister(0x1C, 0x08);

  // 3. Enable 21Hz Digital Low-Pass Filter (Register 0x1A -> 0x04)
  writeMPURegister(0x1A, 0x04);

  Serial.println("✅ SUCCESS: MPU6050 Awake! Streaming X, Y, Z acceleration...\n");
}

void loop() {
  float ax, ay, az;

  if (readAccel(ax, ay, az)) {
    Serial.printf("Accel -> X: %6.2f m/s^2 | Y: %6.2f m/s^2 | Z: %6.2f m/s^2\n", ax, ay, az);
  } else {
    Serial.println("⚠️ [WARNING] I2C Read Failed - Check for loose jumper wires!");
  }

  delay(200);
}
