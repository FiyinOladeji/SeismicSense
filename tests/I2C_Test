#include <Wire.h>

void setup() {
  Serial.begin(115200);
  delay(1000);
  Wire.begin(21, 22); // Explicitly set SDA = 21, SCL = 22
  Serial.println("\n--- I2C Bus Scanner ---");
}

void loop() {
  byte error, address;
  int found = 0;

  for (address = 1; address < 127; address++) {
    Wire.beginTransmission(address);
    error = Wire.endTransmission();

    if (error == 0) {
      Serial.printf("SUCCESS: I2C device found at address 0x%02X!\n", address);
      found++;
    }
  }
  if (found == 0) {
    Serial.println("ERROR: No I2C devices found. Check SDA(21)/SCL(22) wiring or header solder joints.");
  }
  delay(2000);
}
